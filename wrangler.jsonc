{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "visitrip",
	"main": "apps/api/src/worker.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "apps/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "VISITRIP_DB",
			"database_name": "visitrip",
			"database_id": "fb56505b-c068-4c8d-9a9f-5f021913e4f0",
			"migrations_dir": "packages/db/migrations-d1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "TRIP_DO",
				"class_name": "TripDoc"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["TripDoc"]
		}
	],
	"vars": {
		"PUBLIC_URL": "https://visitrip.ms0242808.workers.dev"
	}
}

# Postgres
POSTGRES_USER=visitrip
POSTGRES_PASSWORD=visitrip
POSTGRES_DB=visitrip
DATABASE_URL=postgres://visitrip:visitrip@localhost:5432/visitrip

# API
PORT=3001
WEB_ORIGIN=http://localhost:5173

# better-auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3001

# Set to "true" to auto-apply Drizzle migrations on API boot.
# Defaults to "true" in production (docker-compose); recommended "false" in local dev
# where you run "npm run db:migrate" yourself.
AUTO_MIGRATE=false

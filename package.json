{
  "name": "visitrip",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source app for organizing, sharing, and collaborating on trips.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev -w @visitrip/web",
    "dev:api": "npm run dev -w @visitrip/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w @visitrip/db",
    "db:migrate": "npm run db:migrate -w @visitrip/db",
    "db:studio": "npm run db:studio -w @visitrip/db"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
